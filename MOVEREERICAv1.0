                other.gameObject.SetActive(false);
            }
            else
            {
                audioSource.PlayOneShot(somDaPortaFechada);
            }
        }
        //PORTAK
        if (other.CompareTag("PortaK"))//Abre a Porta K
        {
            if (chaveK == true)
