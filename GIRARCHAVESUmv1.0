using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class GirarChave : MonoBehaviour
{
    // Start is called before the first frame update
    public float velocidade = 90f; // graus por segundo

    void Update()
    {
        // Gira no próprio eixo local
        transform.Rotate(Vector3.right * velocidade * Time.deltaTime, Space.Self);
    }
}
